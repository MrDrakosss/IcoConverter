<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IcoConverter</AssemblyName>
    <RootNamespace>IcoConverter</RootNamespace>
    <ApplicationTitle>ICO Konverter</ApplicationTitle>
    <Version>2.0.0</Version>
    <Product>ICO Konverter</Product>
    <Company>Shelter Team Studio</Company>
    <Authors>Shelter Team Studio</Authors>
    <Copyright>© 2026 Shelter Team Studio</Copyright>
    <Description>PNG, JPG és JPEG képek átalakítása több felbontású .ico fájllá</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
  </ItemGroup>

</Project>
